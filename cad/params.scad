// GENERATED by cad/sync_params.py -- do not edit by hand.
// Kinematic values come from reference/quadruped/robot.py:RobotConfig.
// Re-run the script after changing RobotConfig.

// ---------------------------------------------------------------
// KINEMATIC -- these three must match the controller exactly.
// Everything else is free; these are not.
// ---------------------------------------------------------------
HIP_OFFSET = 46.0;   // roll axis -> leg plane (== leg_plane below)
THIGH      = 110.0;  // hip pitch axis -> knee axis
SHANK      = 130.0;  // knee axis -> FOOT BALL CENTRE
BODY_LEN   = 200.0;  // front roll axis -> rear roll axis
BODY_WID   = 110.0;  // left roll axis -> right roll axis

// The foot is a ball, so SHANK ends at its CENTRE, not at the
// ground. A ball's contact point is always FOOT_R directly below
// its centre whatever angle the shank is at, so the IK solving to
// the centre is exactly right -- the robot simply stands FOOT_R
// higher than STAND_HEIGHT. Measured off the exported assembly,
// the four ball centres land within 0.02 mm of where the solver
// puts them.
// Roll axis height above the underside of the chassis plate. The
// servo lies flat on the plate, so this is the plate's skin plus
// half the housing. ONE definition: chassis.scad builds to it,
// robot.scad places the legs at it, check_fit.py checks at it.
HIP_Z        = 21.0;
STAND_HEIGHT = 176.7;  // hip to ball centre
RIDE_HEIGHT  = 185.7;  // hip to the ground
MASS_EST     = 2.06;    // kg, for the record

// ---------------------------------------------------------------
// JOINT TRAVEL -- what the gait actually commands, measured across
// every gait and direction. Brackets must clear these or the leg
// hits itself mid-stride. Limits are the IK's hard stops.
// ---------------------------------------------------------------
ROLL_USED  = [-27.5,  27.5];   ROLL_LIMIT = [-35.0, 35.0];
HIP_USED   = [-89.6,  16.9];   HIP_LIMIT  = [-90.0, 90.0];
KNEE_USED  = [ 21.6, 115.1];   KNEE_LIMIT = [15.0, 150.0];

// ---------------------------------------------------------------
// SERVO -- DS3225, standard size.
//
// MEASURE YOUR OWN BEFORE PRINTING TWELVE OF ANYTHING. Servo body
// size is near-universal for 'standard size', but the mounting
// flange hole pattern is NOT standardised between manufacturers.
// Calipers on one real servo, then correct the four SERVO_HOLE
// values below. This is a five-minute check that saves a failed
// print of every bracket on the robot.
// ---------------------------------------------------------------
SERVO_L = 40.0;    // body length
SERVO_W = 20.0;    // body width
SERVO_H = 40.4;    // body height, shaft face to bottom
SERVO_FLANGE_L  = 54.0;  // overall length across the mounting ears
SERVO_FLANGE_TH =  2.5;  // ear thickness
SERVO_FLANGE_Z  = 30.0;  // ear height above the body bottom
SERVO_HOLE_DX   = 49.5;  // hole spacing, lengthwise  <-- MEASURE
SERVO_HOLE_DY   = 10.0;  // hole spacing, crosswise   <-- MEASURE
SERVO_HOLE_D    =  4.2;  // hole diameter             <-- MEASURE
SERVO_SHAFT_OFF = 10.0;  // shaft offset from body centre, lengthwise
SERVO_SPLINE_D  =  5.92; // 25T spline outer diameter
SERVO_HORN_D    = 22.0;  // round horn diameter, for the pocket
SERVO_HORN_TH   =  2.0;
// Fit allowance on the servo's own pocket, on top of CLEAR.
//
// A "standard size" servo is NOT one size. Three listings for
// the same 25 kg class measure 40.0 x 20.5 x 40.5, 40.5 x 20.2 x
// 40.3 and 40.0 x 20.0 x 40.5, and a dimension drawing for the
// genuine DS3225MG gives 54.5 across the ears where this file
// said 54.0. Sized to any one of them, the pocket comes out 0.1
// mm oversize for the others -- which is less than the printer
// managed, so the servo simply will not go in.
//
// 0.6 takes a body up to 0.5 mm over nominal and still leaves
// 0.35 a side. The four mounting screws are what locate the
// servo, so slack in the pocket costs nothing.
SERVO_FIT       =  0.6;

// ---------------------------------------------------------------
// HIP STACK. A servo's body always sits on the FAR side of its own
// joint -- never between that joint and the robot's centre, or it
// adds its whole 40.4 mm length to HIP_OFFSET.
// ---------------------------------------------------------------
ROLL_HALF   = 20.0;   // roll collar boss, +/- this
THIGH_IN    = 27.0;   // thigh plate, inboard face
THIGH_OUT   = 35.0;   // thigh plate, outboard face
HIP_COLLAR  = 35.0;   // thigh collar ring, inboard end
KNEE_COLLAR = 35.0;   // shank collar ring, inboard end
PITCH_FACE  = 45.0;   // pitch servo shaft face (horn inboard)
PITCH_OUT   = 85.4;   // pitch servo body, outboard end
KNEE_FACE   = 63.6;   // knee servo shaft face, on the crank boss
KNEE_OUT    = 104.0;   // knee servo body, outboard end
LINK_IN     = 42.0;   // crank + rocker plane (the shank's own)
LINK_OUT    = 50.0;   // crank + rocker plane, outboard face
ROD_IN      = 50.8;   // pushrod plane, inboard face
ROD_OUT     = 55.8;   // pushrod plane, outboard face
CRANK_HUB   = 63.6;   // crank boss, outboard face
SHANK_IN    = 42.0;   // shank plate, inboard face
PLATE_T     = 8.0;   // thigh plate thickness
SHANK_T     = 8.0;    // shank plate thickness
HIP_COLLAR_H  = 10.0;  // pitch journal engagement
KNEE_COLLAR_H = 7.0;  // knee journal engagement
ROLL_GAP    = 7.0;    // roll collar -> thigh plate, sets the leg plane

// ---------------------------------------------------------------
// SHANK SECTION -- a tapered plate, SHANK_T thick. Sized for a
// sideways scuff at the foot: 10.1 N over 130 mm
// = 1.31 N.m at the knee. Stresses below are printed by
// check_walls.py; PETG yields near 50 MPa, derate to ~30 across
// the layer lines.
// ---------------------------------------------------------------
SHANK_W_KNEE = 20.0;  // width just below the knee collar
SHANK_W_FOOT = 13.0;  // width at the ankle
FOOT_R       = 9.0;   // foot ball radius

// ---------------------------------------------------------------
// LEG PLAN -- outline radii. One copy, read by leg.scad and by
// check_walls.py, so the audit cannot report on a stale shape.
// ---------------------------------------------------------------
JOINT_BORE_D = 36.0;   // collar runs in this bore
HEAD_R       = 21.0;   // thigh plate, hip end
KNEE_R       = 15.5;   // thigh plate, knee end  (also the
                      //   shank's collar end)
TRUSS_RAIL   = 3.5;  // web left between truss triangles
TRUSS_FILLET = 3.0;  // corner radius inside the truss

// ---------------------------------------------------------------
// SHOULDER ARM. One copy, read by shoulder.scad (which draws the
// arm) and by chassis.scad (which has to cut room for it). They
// used to each keep their own: the chassis was still cutting for
// a 26 mm arm after the real one had grown past 33.
//
// ARM_Y0/ARM_Y1 is the band the arm crosses the thigh's plane in.
// It is pinned between the roll servo's 20 mm width (so the arm
// can pass in front of it on the rear legs) and the thigh plate.
// ---------------------------------------------------------------
SWEEP_CLR        = 25.0;   // arm's offset from the roll axis
SHELL_Z          = 26.0;   // arm and housing depth
ARM_Y0           = -12.0;   // arm leaves the boss here
ARM_Y1           = 22.0;
ARM_T            = 24.0;   // tongue depth, shallower than the housing
SHOULDER_SWEEP_R = 26.1;   // how much chassis to cut away

// ---------------------------------------------------------------
// KNEE LINKAGE -- a parallelogram. Crank and rocker are the SAME
// length and the rod equals the crank-to-knee distance; that is
// what makes the ratio exactly 1.0 instead of a general four-bar's
// 0.12 worst case. Change one of the three and the others must
// follow, so they come from transmission.py and are not typed.
//
// rod carries 73 N at 1.09 N.m of knee torque
// crank stays 22.5 deg clear of a dead point
// ---------------------------------------------------------------
LINK_A    = 15.0;    // crank AND rocker length
LINK_D    = 46.0;    // crank axis -> knee axis, AND rod length
LINK_PHI  = -172.5;  // shank -> rocker, fixed
CRANK_C   = 64.0;    // crank axis, measured down the thigh
LINK_T    = 8.0;     // crank and rocker plate thickness
LINK_TIP_R = 6.0;   // rounded end on each arm
ROD_T     = 5.0;     // pushrod thickness
// EVERY LINKAGE PIVOT IS A SHOULDER BOLT, not a screw.
//
// A screw through both parts pulls them together and the joint
// stops being a joint. A shoulder bolt has a plain 4 mm shank
// that is LONGER than the rod is thick, so the rod turns on the
// shank while the thread pulls the shoulder's end face down onto
// the arm. The clamp load never reaches the rod.
//
//   rod end     4.2 mm clearance -- it must be free to turn
//   arm end     M3 heat-set insert, PIVOT_INSERT_H deep
//   bolt        M3 thread, 4 mm shoulder, 6 mm long against a
//               5 mm rod: 1 mm of end float, plus a washer
PIVOT_BOLT_D   = 4.0;   // the shoulder itself
PIVOT_ROD_D    = 4.2;   // clearance for it in the rod
PIVOT_INSERT_H = 6.0;
PIVOT_D   = 3.4;    // M3 clearance, where something IS meant to clamp
CRANK_SWEEP = [-157.5, -22.5];  // from the thigh line

// ---------------------------------------------------------------
// STANDING POSE -- solved by quadruped.robot, not typed. The
// assembly renders in a pose the controller can actually hold,
// and FOOT_* is where that pose must put the foot.
// ---------------------------------------------------------------
POSE_ROLL = 0.000;
POSE_HIP  = -47.195;
POSE_KNEE = 85.569;
FOOT_X    = 0.000;   // from the roll axis, in the leg frame
FOOT_Y    = 46.000;
FOOT_Z    = -176.663;

// ---------------------------------------------------------------
// IDLER BEARING -- the second support on every joint.
//
// The DS3225 has only one output shaft, so each joint gets a
// printed bearing boss opposite it. Without this the servo's own
// output bearing carries the full bending moment (1.17 N.m at the
// knee) in a direction it was never specified for, and the joint
// develops play. 624ZZ runs on an M4 bolt: cheap, common, and the
// bolt is a far better shaft than printed plastic.
// ---------------------------------------------------------------
BEARING_OD = 13.0;  // 624ZZ
BEARING_ID =  4.0;
BEARING_TH =  5.0;
BEARING_FIT = 0.05; // press fit: negative clearance, tighten if loose

// ---------------------------------------------------------------
// PRINT -- tuned for PETG. PLA creeps under sustained load and the
// legs are loaded whenever the robot is switched on.
// ---------------------------------------------------------------
WALL      = 3.0;   // structural wall thickness
CLEAR     = 0.3;   // clearance on parts that must slide or rotate
M3_CLEAR  = 3.4;   // M3 through-hole
M3_INSERT = 4.0;   // M3 heat-set insert pilot hole  <-- CHECK YOURS
M4_CLEAR  = 4.5;
M4_INSERT = 5.6;   // M4 heat-set insert pilot  <-- CHECK YOURS
FILLET    = 2.0;
$fn = 48;
